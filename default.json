{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "schedule": [
    "before 6am on monday"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "nix": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Malicious releases are usually pulled within days.",
      "matchDatasources": [
        "npm",
        "crate"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "groupName": "npm dependencies"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "nix"
      ],
      "groupName": "Nix flake inputs"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "matchCurrentVersion": "/^[~^=v]*0\\./",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "xescure/ci"
      ],
      "groupName": null,
      "schedule": [
        "at any time"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "@keetanetwork/**"
      ],
      "groupName": "Keeta",
      "rangeStrategy": "pin",
      "minimumReleaseAge": null,
      "schedule": [
        "at any time"
      ]
    },
    {
      "description": "typescript-eslint supports TypeScript up to 6.0.",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ]
}
